#
# 复制成 .env 后填真实值：cp .env.example .env && chmod 600 .env
# 该文件进 .gitignore / .dockerignore，不会被镜像带走。

# ── 必填 ──────────────────────────────────────────────────────
# 平台默认路由（provider/model，见 shell/providers.json）
ALPHA_DEFAULT_ROUTE=dashscope/qwen-plus-latest
DASHSCOPE_API_KEY=

# ── 访问控制 ──────────────────────────────────────────────────
# 1=邀请制注册；0=开放注册（上架审核期需要公开可用）
ALPHA_REQUIRE_INVITE=0
# 管理端点用：/api/admin/**，请求头 X-Alpha-Admin-Token
ALPHA_ADMIN_TOKEN=

# ── 产品形态 ──────────────────────────────────────────────────
# 只开放 xiaolan（#99）
ALPHA_PERSONAS=xiaolan
ALPHA_OPENAI_DEFAULT_PERSONA=xiaolan
# 平台免费额度（token/天）；BYOK 订阅用户走自己的 Key
ALPHA_PLATFORM_DAILY_TOKENS=50000
# 注销冷静期（天，默认 7）
ALPHA_DELETE_COOLING_DAYS=7

# ── 容器/网络 ─────────────────────────────────────────────────
ALPHA_HOST=0.0.0.0
ALPHA_PORT=8000
ALPHA_PUBLIC_URL=https://47.239.51.212.sslip.io
ALPHA_DOMAIN=47.239.51.212.sslip.io
# 镜像 tag（deploy 脚本自动写 git short sha）
ALPHA_TAG=latest
# 可选：直接从镜像仓库拉取（留空则用本机构建的 alpha:${ALPHA_TAG}）
ALPHA_IMAGE=

# ── 数据位置（compose 卷）──────────────────────────────────────
# 宿主机目录；容器内固定 /var/lib/prealpha
ALPHA_DATA_DIR=/var/lib/prealpha
# 容器内进程 uid/gid（须与宿主机数据目录属主一致，默认 alpha=1000）
ALPHA_UID=1000
ALPHA_GID=1000
# 引擎数据（chat.db/openher.db/memory.db）
ALPHA_ENGINE_DIR=/opt/prealpha/vendor/OpenHer/.data
# 备份目录；不配则注销回执会注明「数据只在本机」
ALPHA_BACKUP_DIR=/opt/prealpha/backups
# 宿主机 Caddy 证书目录（compose 挂到 /data，复用已有证书）
ALPHA_CADDY_DATA=/var/lib/caddy/.local/share/caddy
ALPHA_BACKUP_RETENTION_DAYS=30

# ── 举报通知（可选）───────────────────────────────────────────
# 配了就把新举报 POST 过去（飞书/企业微信/Slack/Telegram 机器人）
ALPHA_REPORT_WEBHOOK=
ALPHA_REPORT_LOG=/var/lib/prealpha/reports.log
# 邮件通知（163 必须用授权码；不配就不发）
ALPHA_SMTP_HOST=
ALPHA_SMTP_PORT=465
ALPHA_SMTP_USER=
ALPHA_SMTP_PASS=
ALPHA_SMTP_FROM=
ALPHA_NOTIFY_EMAIL=

# ── 支付（Waffo）─────────────────────────────────────────────
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
# PKCS#8 DER 的 base64（单行）
WAFFO_PRIVATE_KEY_B64=
# Webhook 公钥 PEM 的 base64（含 BEGIN/END 两行！少一行会 401）
WAFFO_WEBHOOK_PUBLIC_KEY_B64=
WAFFO_PRODUCT_BYOK_MONTHLY=
WAFFO_PRODUCT_BYOK_YEARLY=
ALPHA_BILLING_MODE=test
