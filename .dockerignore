# 构建上下文排除：数据库、密钥、虚拟环境、缓存
.git
.github
.gitignore
.dockerignore

# 本地运行时数据（绝不进镜像）
.data
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
*.pem
*.key
.env
.env.*
!.env.example

# Python 缓存与虚拟环境
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
vendor/OpenHer/.venv
**/node_modules

# 引擎运行数据（compose 用卷挂载）
vendor/OpenHer/.data
vendor/OpenHer/genome
docs/legal-snapshots

# 其它
.DS_Store
tmp
